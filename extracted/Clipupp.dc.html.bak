    <!-- featured case study spotlight -->
    <article data-reveal data-parallax-wrap style="position:relative; border-radius:24px; overflow:hidden; background:linear-gradient(150deg,#0A0E1A,#11193A); color:#fff; display:grid; grid-template-columns:1.05fr .95fr; gap:0; box-shadow:0 40px 90px -40px rgba(11,16,32,.6);">
      <div style="position:absolute; inset:0; background-image:radial-gradient(rgba(255,255,255,.05) 1px,transparent 1px); background-size:3px 3px; opacity:.5; pointer-events:none;"></div>
      <div style="position:relative; padding:46px 44px;">
        <div style="display:inline-flex; align-items:center; gap:8px; padding:6px 12px; border:1px solid rgba(255,255,255,.14); border-radius:8px; font-family:'Geist Mono',monospace; font-size:11px; letter-spacing:.05em; text-transform:uppercase; color:#A9C2FF;">Financial Services · Case study</div>
        <h3 style="margin:24px 0 0; font-size:30px; font-weight:600; letter-spacing:-.025em; line-height:1.12; max-width:440px;">How Finovo cut loan approval from 3 days to 20 minutes.</h3>
        <p style="margin:16px 0 0; font-size:15.5px; line-height:1.6; color:#AEB7CC; max-width:460px;">Finovo's loan operations ran on spreadsheets, email, and three disconnected systems. We built an AI-assisted underwriting workflow with human approval on every sanction — applications now route, score, and update themselves.</p>
