<script type="text/x-dc" data-dc-script>
class Component extends DCLogic {
  rootRef = React.createRef();

  renderVals() {
    return { brand: 'Go Unmanual', year: 2026, rootRef: this.rootRef };
  }

  componentDidMount() {
    const root = this.rootRef.current;
    if (!root) return;
    const reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    this._cleanups = [];

    this.setupScrollReveal(root, reduced);
    this.setupTabs(root);
    this.setupHeader(root);
    this.setupParallax(root, reduced);
    this.setupMobileNav(root);
    this.setupNavScroll(root);
    this.setupResponsive(root);

    if (reduced) {
      root.querySelectorAll('svg').forEach(s => { try { s.pauseAnimations && s.pauseAnimations(); } catch (e) {} });
      const mq = root.querySelector('[data-marquee-track]');
      if (mq) mq.style.animation = 'none';
    }
  }

  componentWillUnmount() {
    (this._cleanups || []).forEach(fn => { try { fn(); } catch (e) {} });
  }

  setupScrollReveal(root, reduced) {
    const reveals = Array.from(root.querySelectorAll('[data-reveal]'));
    const counters = Array.from(root.querySelectorAll('[data-counter]'));
    const stepLine = root.querySelector('[data-step-line]');
    const fmt = (v, dec) => {
      const n = dec > 0 ? v.toFixed(dec) : Math.round(v);
      return Number(n).toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec });
    };
    const animateCounter = (el) => {
      const target = parseFloat(el.dataset.counter);
      const dec = parseInt(el.dataset.dec || 0);
      if (reduced) { el.textContent = fmt(target, dec); return; }
      const dur = 1700, start = performance.now();
      const tick = (now) => {
        let p = Math.min(1, (now - start) / dur);
        p = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(target * p, dec);
        if (p < 1) requestAnimationFrame(tick); else el.textContent = fmt(target, dec);
      };
      requestAnimationFrame(tick);
    };
    if (reduced) {
      reveals.forEach(e => { e.style.opacity = 1; });
      counters.forEach(animateCounter);
      if (stepLine) stepLine.style.transform = 'scaleX(1)';
      return;
    }
    const shown = new Set(), counted = new Set();
    let lineShown = false, raf = null;
    const h = () => window.innerHeight || 800;
    // Hide only elements clearly below the fold; above-the-fold stays painted (no blank flash).
    reveals.forEach(e => {
      const r = e.getBoundingClientRect();
      if (r.top > h() * 0.9) {
        e.style.opacity = 0;
        e.style.transform = 'translateY(26px)';
        e.style.transition = 'opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1)';
        e.style.willChange = 'opacity, transform';
      } else {
        shown.add(e);
      }
    });
    const revealEl = (e) => {
      if (shown.has(e)) return;
      shown.add(e);
      const d = parseFloat(e.dataset.revealDelay || 0);
      e.style.transitionDelay = d + 'ms';
      e.style.opacity = 1;
      e.style.transform = 'none';
    };
    const countEl = (e) => { if (!counted.has(e)) { counted.add(e); animateCounter(e); } };
    const showLine = () => { if (stepLine && !lineShown) { lineShown = true; stepLine.style.transform = 'scaleX(1)'; } };
    const vis = (el, gap) => { const r = el.getBoundingClientRect(); return r.top < h() * (1 - gap) && r.bottom > -40; };
    const check = () => {
      raf = null;
      reveals.forEach(e => { if (!shown.has(e) && vis(e, 0.08)) revealEl(e); });
      counters.forEach(e => { if (!counted.has(e) && vis(e, 0)) countEl(e); });
      if (stepLine && vis(stepLine, 0)) showLine();
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(check); };

    // Primary trigger: IntersectionObserver (fires without scroll events; works in embedded iframes).
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((ents) => {
        ents.forEach(en => {
          if (!en.isIntersecting) return;
          const t = en.target;
          if (t.hasAttribute('data-counter')) countEl(t);
          else if (t.hasAttribute('data-step-line')) showLine();
          else revealEl(t);
          io.unobserve(t);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
      reveals.forEach(e => { if (!shown.has(e)) io.observe(e); });
      counters.forEach(e => io.observe(e));
      if (stepLine) io.observe(stepLine);
      this._cleanups.push(() => io.disconnect());
    }
    // Enhancement + fallback: scroll position checks.
    check();
    requestAnimationFrame(() => { check(); requestAnimationFrame(check); });
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('scroll', onScroll, { passive: true, capture: true });
    window.addEventListener('resize', onScroll);
    // Safety net: never leave content permanently hidden if no scroll/IO ever fires.
    const safety = setTimeout(() => { reveals.forEach(revealEl); counters.forEach(countEl); showLine(); }, 2600);
    this._cleanups.push(() => {
      clearTimeout(safety);
      window.removeEventListener('scroll', onScroll);
      document.removeEventListener('scroll', onScroll, { capture: true });
      window.removeEventListener('resize', onScroll);
    });
  }

  setupReveal(root, reduced) {
    const els = Array.from(root.querySelectorAll('[data-reveal]'));
    if (reduced || !('IntersectionObserver' in window)) {
      els.forEach(e => { e.style.opacity = 1; });
      return;
    }
    els.forEach(e => {
      e.style.opacity = 0;
      e.style.transform = 'translateY(26px)';
      e.style.transition = 'opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1)';
      e.style.willChange = 'opacity, transform';
    });
    const io = new IntersectionObserver((ents) => {
      ents.forEach(en => {
        if (en.isIntersecting) {
          const el = en.target;
          const d = parseFloat(el.dataset.revealDelay || 0);
          el.style.transitionDelay = d + 'ms';
          el.style.opacity = 1;
          el.style.transform = 'none';
          io.unobserve(el);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -7% 0px' });
    els.forEach(e => io.observe(e));
    this._cleanups.push(() => io.disconnect());
  }

  setupCounters(root, reduced) {
    const els = Array.from(root.querySelectorAll('[data-counter]'));
    const fmt = (v, dec) => {
      const n = dec > 0 ? v.toFixed(dec) : Math.round(v);
      return Number(n).toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec });
    };
    const animate = (el) => {
      const target = parseFloat(el.dataset.counter);
      const dec = parseInt(el.dataset.dec || 0);
      if (reduced) { el.textContent = fmt(target, dec); return; }
      const dur = 1700;
      const start = performance.now();
      const tick = (now) => {
        let p = Math.min(1, (now - start) / dur);
        p = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(target * p, dec);
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = fmt(target, dec);
      };
      requestAnimationFrame(tick);
    };
    if (!('IntersectionObserver' in window)) { els.forEach(animate); return; }
    const io = new IntersectionObserver((ents) => {
      ents.forEach(en => { if (en.isIntersecting) { animate(en.target); io.unobserve(en.target); } });
    }, { threshold: 0.5 });
    els.forEach(e => io.observe(e));
    this._cleanups.push(() => io.disconnect());
  }

  setupTabs(root) {
    const btns = Array.from(root.querySelectorAll('[data-tab]'));
    const panels = Array.from(root.querySelectorAll('[data-panel]'));
    const activate = (key) => {
      btns.forEach(b => {
        const on = b.dataset.tab === key;
        b.style.background = on ? '#1E40AF' : '#fff';
        b.style.color = on ? '#fff' : '#41495A';
        b.style.borderColor = on ? '#1E40AF' : 'rgba(17,22,31,.1)';
        b.style.boxShadow = on ? '0 8px 20px -8px rgba(30,64,175,.6)' : 'none';
        b.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panels.forEach(p => {
        const on = p.dataset.panel === key;
        p.style.display = on ? 'grid' : 'none';
      });
    };
    btns.forEach(b => {
      b.setAttribute('role', 'tab');
      b.addEventListener('click', () => activate(b.dataset.tab));
    });
    activate('hr');
  }

  setupHeader(root) {
    const header = root.querySelector('[data-header]');
    if (!header) return;
    const onScroll = () => {
      const s = window.scrollY > 16;
      header.style.background = s ? 'rgba(247,246,243,.82)' : 'transparent';
      header.style.backdropFilter = s ? 'saturate(180%) blur(16px)' : 'none';
      header.style.webkitBackdropFilter = s ? 'saturate(180%) blur(16px)' : 'none';
      header.style.borderBottomColor = s ? 'rgba(17,22,31,.08)' : 'transparent';
      header.style.boxShadow = s ? '0 6px 24px -16px rgba(17,22,31,.4)' : 'none';
      header.style.padding = s ? '12px 0' : '20px 0';
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    this._cleanups.push(() => window.removeEventListener('scroll', onScroll));
  }

  setupParallax(root, reduced) {
    if (reduced) return;
    const el = root.querySelector('[data-parallax]');
    const wrap = root.querySelector('[data-parallax-wrap]');
    if (!el || !wrap) return;
    let raf = null;
    const baseTransform = 'perspective(1200px) rotateX(6deg) rotateY(-7deg)';
    const update = () => {
      raf = null;
      const r = wrap.getBoundingClientRect();
      const vh = window.innerHeight;
      const prog = (r.top + r.height / 2 - vh / 2) / vh; // -ish range
      const y = Math.max(-24, Math.min(24, -prog * 34));
      el.style.transform = baseTransform + ' translateY(' + y.toFixed(1) + 'px)';
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    this._cleanups.push(() => window.removeEventListener('scroll', onScroll));
  }

  setupMobileNav(root) {
    const toggle = root.querySelector('[data-mobile-toggle]');
    const menu = root.querySelector('[data-mobile-menu]');
    if (!toggle || !menu) return;
    let open = false;
    const setOpen = (v) => {
      open = v;
      menu.style.display = v ? 'block' : 'none';
      toggle.setAttribute('aria-expanded', v ? 'true' : 'false');
    };
    toggle.addEventListener('click', () => setOpen(!open));
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setOpen(false)));
  }

  setupNavScroll(root) {
    const header = root.querySelector('[data-header]');
    const links = Array.from(root.querySelectorAll('[data-scroll]'));
    const onClick = (e, sel) => {
      const target = root.querySelector(sel);
      if (!target) return;
      e.preventDefault();
      const offset = (header ? header.offsetHeight : 70) + 14;
      const top = target.getBoundingClientRect().top + window.scrollY - offset;
      window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
    };
    links.forEach(a => {
      const sel = a.getAttribute('data-scroll');
      a.addEventListener('click', (e) => onClick(e, sel));
    });
  }

  setupStepLine(root, reduced) {
    const line = root.querySelector('[data-step-line]');
    if (!line) return;
    if (reduced) { line.style.transform = 'scaleX(1)'; return; }
    if (!('IntersectionObserver' in window)) { line.style.transform = 'scaleX(1)'; return; }
    const io = new IntersectionObserver((ents) => {
      ents.forEach(en => {
        if (en.isIntersecting) { line.style.transform = 'scaleX(1)'; io.unobserve(en.target); }
      });
    }, { threshold: 0.4 });
    io.observe(line);
    this._cleanups.push(() => io.disconnect());
  }

  setupResponsive(root) {
    const apply = () => {
      const w = window.innerWidth;
      const desktopNav = root.querySelector('[data-desktop-nav]');
      const desktopCta = root.querySelector('[data-desktop-cta]');
      const mToggle = root.querySelector('[data-mobile-toggle]');
      const mMenu = root.querySelector('[data-mobile-menu]');
      const isMobile = w < 1024;
      if (desktopNav) desktopNav.style.display = isMobile ? 'none' : 'flex';
      if (desktopCta) desktopCta.style.display = isMobile ? 'none' : 'flex';
      if (mToggle) mToggle.style.display = isMobile ? 'flex' : 'none';
      if (!isMobile && mMenu) mMenu.style.display = 'none';

      // grid collapses
      const setCols = (sel, mobile, desktop) => {
        const el = root.querySelector(sel);
        if (el) el.style.gridTemplateColumns = w < 960 ? mobile : desktop;
      };
      setCols('[data-hero-grid]', '1fr', 'minmax(0,1.04fr) minmax(0,.96fr)');
      setCols('[data-stat-grid]', w < 620 ? '1fr 1fr' : 'repeat(4,1fr)', 'repeat(4,1fr)');
      setCols('[data-outcomes]', w < 620 ? '1fr 1fr' : 'repeat(4,1fr)', 'repeat(4,1fr)');
      setCols('[data-engagement]', w < 620 ? '1fr' : '1fr 1fr', 'repeat(4,1fr)');
      setCols('[data-testi]', '1fr', '1.4fr 1fr');
      setCols('[data-cta-grid]', '1fr', '1.1fr .9fr');
      setCols('[data-steps]', w < 720 ? '1fr 1fr' : 'repeat(4,1fr)', 'repeat(4,1fr)');

      // bento spans
      const bento = root.querySelector('[data-bento]');
      if (bento) {
        const arts = Array.from(bento.children);
        if (w < 760) {
          bento.style.gridTemplateColumns = '1fr';
          arts.forEach(a => a.style.gridColumn = 'span 1');
        } else if (w < 1000) {
          bento.style.gridTemplateColumns = 'repeat(6,1fr)';
          const spans = ['span 6','span 6','span 3','span 3','span 3','span 3'];
          arts.forEach((a,i) => a.style.gridColumn = spans[i] || 'span 3');
        } else {
          bento.style.gridTemplateColumns = 'repeat(12,1fr)';
          const spans = ['span 7','span 5','span 5','span 4','span 3'];
          arts.forEach((a,i) => a.style.gridColumn = spans[i] || 'span 4');
        }
      }

      // panels stack
      root.querySelectorAll('[data-panel]').forEach(p => {
        if (p.style.display !== 'none') p.style.gridTemplateColumns = w < 760 ? '1fr' : '1.15fr .85fr';
        else p.dataset.cols = w < 760 ? '1fr' : '1.15fr .85fr';
      });
      // case study
      const cs = root.querySelector('[data-parallax-wrap]');
      if (cs) cs.style.gridTemplateColumns = w < 860 ? '1fr' : '1.05fr .95fr';
      // footer
      const fcols = root.querySelector('footer > div > div');
      if (fcols) fcols.style.gridTemplateColumns = w < 760 ? '1fr 1fr' : (w < 1000 ? '1.4fr 1fr 1fr' : '1.6fr 1fr 1fr 1fr 1.2fr');
    };
    apply();
    window.addEventListener('resize', apply);
    // re-apply panel cols on tab switch
    root.querySelectorAll('[data-tab]').forEach(b => b.addEventListener('click', () => requestAnimationFrame(apply)));
    this._cleanups.push(() => window.removeEventListener('resize', apply));
  }
}
</script>
</body>
</html>
