      <div data-reveal style="position:relative; padding-right:26px;">
        <div style="position:relative; width:60px; height:60px; border-radius:16px; background:#0A0E1A; border:1px solid rgba(255,255,255,.16); display:flex; align-items:center; justify-content:center; font-family:'Geist Mono',monospace; font-size:18px; font-weight:600; color:#22D3EE; z-index:2;">01</div>
        <h3 style="margin:22px 0 0; font-size:20px; font-weight:600; letter-spacing:-.01em;">Discover</h3>
        <p style="margin:10px 0 0; font-size:14.5px; line-height:1.55; color:#C3CEF0;">We learn your business and goals, scope the work, and give you a clear plan, timeline, and fixed quote <em>before</em> we build anything.</p>
      </div>
      <div data-reveal data-reveal-delay="120" style="position:relative; padding:0 26px;">
        <div style="position:relative; width:60px; height:60px; border-radius:16px; background:#0A0E1A; border:1px solid rgba(255,255,255,.16); display:flex; align-items:center; justify-content:center; font-family:'Geist Mono',monospace; font-size:18px; font-weight:600; color:#22D3EE; z-index:2;">02</div>
        <h3 style="margin:22px 0 0; font-size:20px; font-weight:600; letter-spacing:-.01em;">Build</h3>
        <p style="margin:10px 0 0; font-size:14.5px; line-height:1.55; color:#C3CEF0;">We design and build in short, reviewable sprints — you see working software every week, not just slides.</p>
      </div>
      <div data-reveal data-reveal-delay="240" style="position:relative; padding:0 26px;">
        <div style="position:relative; width:60px; height:60px; border-radius:16px; background:#0A0E1A; border:1px solid rgba(255,255,255,.16); display:flex; align-items:center; justify-content:center; font-family:'Geist Mono',monospace; font-size:18px; font-weight:600; color:#22D3EE; z-index:2;">03</div>
