<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: #F7F6F3; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  ::selection { background: #1E40AF; color: #fff; }
  @keyframes cl-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @keyframes cl-mesh { 0% { transform: translate(0,0) scale(1); } 50% { transform: translate(-6%,4%) scale(1.12); } 100% { transform: translate(0,0) scale(1); } }
  @keyframes cl-mesh2 { 0% { transform: translate(0,0) scale(1.1); } 50% { transform: translate(8%,-5%) scale(1); } 100% { transform: translate(0,0) scale(1.1); } }
  @keyframes cl-nodeGlow { 0%,100% { opacity: .35; } 50% { opacity: 1; } }
  @keyframes cl-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  @keyframes cl-spin { to { transform: rotate(360deg); } }
  @keyframes cl-pulseRing { 0% { transform: scale(.8); opacity:.6; } 100% { transform: scale(2.2); opacity:0; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; } }
</style>
</helmet>

<div ref="{{ rootRef }}" style="font-family:'Geist',system-ui,-apple-system,'Segoe UI',sans-serif; color:#11161F; background:#F7F6F3; overflow-x:hidden; position:relative;">

<!-- ============ NAV (shared) ============ -->
<dc-import name="ClipNav" active="home" hint-size="100%,1px"></dc-import>

<!-- ============ HERO ============ -->
<section id="top" style="position:relative; padding:148px 0 70px;">
  <!-- faint grid texture -->
  <div style="position:absolute; inset:0; background-image:linear-gradient(rgba(17,22,31,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(17,22,31,.035) 1px,transparent 1px); background-size:54px 54px; -webkit-mask-image:radial-gradient(120% 90% at 70% 10%,#000 25%,transparent 75%); mask-image:radial-gradient(120% 90% at 70% 10%,#000 25%,transparent 75%); pointer-events:none;"></div>
  <div style="max-width:1240px; margin:0 auto; padding:0 28px; position:relative; display:grid; grid-template-columns:minmax(0,1.04fr) minmax(0,.96fr); gap:46px; align-items:center;" data-hero-grid>
    <!-- LEFT -->
    <div data-reveal>
      <div style="display:inline-flex; align-items:center; gap:9px; padding:7px 13px 7px 9px; border:1px solid rgba(30,64,175,.18); background:rgba(37,99,235,.06); border-radius:100px; font-family:'Geist Mono',monospace; font-size:11.5px; font-weight:500; letter-spacing:.06em; color:#1E40AF; text-transform:uppercase;">
        <span style="display:inline-flex; width:18px; height:18px; border-radius:6px; background:#1E40AF; align-items:center; justify-content:center;"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
        Built &amp; delivered, on time
      </div>
      <h1 style="margin:24px 0 0; font-size:clamp(40px,5.4vw,68px); line-height:1.01; letter-spacing:-.035em; font-weight:300; color:#11161F;">
        The software your<br>business needs — built,<br><span style="font-weight:700;">shipped &amp; supported.</span>
      </h1>
      <p style="margin:26px 0 0; font-size:18.5px; line-height:1.55; color:#48505F; max-width:516px;">
        {{ brand }} builds custom software, AI agents, automation, dashboards, and growth campaigns for Indian businesses — so you cut cost, save time, and move faster, without building an in-house tech team.
      </p>
      <div style="margin:34px 0 0; display:flex; flex-wrap:wrap; gap:13px; align-items:center;">
        <a href="#contact" data-scroll="#contact" style="display:inline-flex; align-items:center; gap:9px; font-size:15.5px; font-weight:600; color:#fff; background:#1E40AF; text-decoration:none; padding:15px 24px; border-radius:12px; box-shadow:0 10px 28px rgba(30,64,175,.32); transition:transform .2s, box-shadow .2s;" style-hover="transform:translateY(-2px); box-shadow:0 16px 38px rgba(30,64,175,.42);">
          Get a free quote
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="#cases" data-scroll="#cases" style="display:inline-flex; align-items:center; gap:9px; font-size:15.5px; font-weight:600; color:#11161F; background:#fff; border:1px solid rgba(17,22,31,.14); text-decoration:none; padding:15px 22px; border-radius:12px; transition:transform .2s, border-color .2s, box-shadow .2s;" style-hover="transform:translateY(-2px); border-color:rgba(30,64,175,.4); box-shadow:0 10px 26px rgba(17,22,31,.1);">
          See our work
        </a>
      </div>
      <div style="margin:38px 0 0; display:flex; align-items:center; gap:18px; flex-wrap:wrap;">
        <div style="display:flex; align-items:center; gap:7px; font-family:'Geist Mono',monospace; font-size:11.5px; font-weight:500; letter-spacing:.04em; color:#6A7180;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1E40AF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>
          NDA-BACKED
        </div>
        <span style="width:4px; height:4px; border-radius:50%; background:#C7CAD1;"></span>
        <div style="font-family:'Geist Mono',monospace; font-size:11.5px; font-weight:500; letter-spacing:.04em; color:#6A7180;">CODE &amp; IP YOURS</div>
        <span style="width:4px; height:4px; border-radius:50%; background:#C7CAD1;"></span>
        <div style="font-family:'Geist Mono',monospace; font-size:11.5px; font-weight:500; letter-spacing:.04em; color:#6A7180;">ON-TIME DELIVERY</div>
        <span style="width:4px; height:4px; border-radius:50%; background:#C7CAD1;"></span>
        <div style="font-size:13px; color:#6A7180;">Trusted by <strong style="color:#11161F;">growing</strong> Indian businesses</div>
      </div>
    </div>
    <!-- RIGHT: flow diagram -->
    <div data-reveal data-reveal-delay="120" style="position:relative;">
      <div style="position:relative; border-radius:24px; background:linear-gradient(160deg,#0B1020 0%,#11193A 60%,#0B1020 100%); padding:22px; box-shadow:0 40px 90px -30px rgba(11,16,32,.6), 0 0 0 1px rgba(255,255,255,.05) inset;">
        <!-- mesh glows -->
        <div style="position:absolute; inset:0; overflow:hidden; border-radius:24px; pointer-events:none;">
          <div style="position:absolute; width:340px; height:340px; left:-60px; top:-40px; background:radial-gradient(circle,rgba(37,99,235,.55),transparent 65%); filter:blur(18px); animation:cl-mesh 11s ease-in-out infinite;"></div>
          <div style="position:absolute; width:300px; height:300px; right:-50px; bottom:-50px; background:radial-gradient(circle,rgba(34,211,238,.32),transparent 65%); filter:blur(18px); animation:cl-mesh2 13s ease-in-out infinite;"></div>
        </div>
        <!-- header chrome -->
        <div style="position:relative; display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;">
          <div style="display:flex; align-items:center; gap:8px; font-family:'Geist Mono',monospace; font-size:11px; letter-spacing:.06em; color:#9AA6C4; text-transform:uppercase;">
            <span style="width:7px; height:7px; border-radius:50%; background:#22D3EE; box-shadow:0 0 10px #22D3EE;"></span>
            invoice-intake.flow · live
          </div>
          <div style="font-family:'Geist Mono',monospace; font-size:11px; color:#69769B;">312 runs / hr</div>
        </div>
        <!-- SVG flow -->
        <svg data-flow viewBox="0 0 600 340" width="100%" style="display:block; position:relative; height:auto;">
          <defs>
            <linearGradient id="cl-edge" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#2563EB" stop-opacity=".35"/>
              <stop offset="1" stop-color="#22D3EE" stop-opacity=".6"/>
            </linearGradient>
            <filter id="cl-glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          </defs>
          <!-- edges: 1 -> 3 (fan out), 3 -> 2 (collect) — symmetric about y=170 -->
          <path id="cl-e1" d="M174 170 C 197 170 197 50 220 50" fill="none" stroke="url(#cl-edge)" stroke-width="1.6"/>
          <path id="cl-e2" d="M174 170 L 220 170" fill="none" stroke="url(#cl-edge)" stroke-width="1.6"/>
          <path id="cl-e3" d="M174 170 C 197 170 197 290 220 290" fill="none" stroke="url(#cl-edge)" stroke-width="1.6"/>
          <path id="cl-e4" d="M380 50 C 403 50 403 100 426 100" fill="none" stroke="url(#cl-edge)" stroke-width="1.6"/>
          <path id="cl-e5" d="M380 170 C 403 170 403 100 426 100" fill="none" stroke="url(#cl-edge)" stroke-width="1.6"/>
          <path id="cl-e6" d="M380 170 C 403 170 403 240 426 240" fill="none" stroke="url(#cl-edge)" stroke-width="1.6"/>
          <path id="cl-e7" d="M380 290 C 403 290 403 240 426 240" fill="none" stroke="url(#cl-edge)" stroke-width="1.6"/>
          <!-- pulses -->
          <g filter="url(#cl-glow)">
            <circle r="3.4" fill="#22D3EE"><animateMotion dur="2.2s" repeatCount="indefinite" begin="0s"><mpath href="#cl-e1"/></animateMotion></circle>
            <circle r="3.4" fill="#7DD3FC"><animateMotion dur="2.6s" repeatCount="indefinite" begin=".4s"><mpath href="#cl-e2"/></animateMotion></circle>
            <circle r="3.4" fill="#22D3EE"><animateMotion dur="3s" repeatCount="indefinite" begin="1.1s"><mpath href="#cl-e3"/></animateMotion></circle>
            <circle r="3.4" fill="#7DD3FC"><animateMotion dur="2.4s" repeatCount="indefinite" begin=".7s"><mpath href="#cl-e5"/></animateMotion></circle>
            <circle r="3.4" fill="#22D3EE"><animateMotion dur="2.8s" repeatCount="indefinite" begin="1.5s"><mpath href="#cl-e6"/></animateMotion></circle>
            <circle r="3.4" fill="#7DD3FC"><animateMotion dur="2.5s" repeatCount="indefinite" begin=".2s"><mpath href="#cl-e4"/></animateMotion></circle>
          </g>
          <!-- nodes: local coords inside each translate(); icon box 12..42 / 11..41, center (27,26) -->
          <g transform="translate(14,144)">
            <rect width="160" height="52" rx="13" fill="#131B33" stroke="rgba(255,255,255,.1)"/>
            <rect x="12" y="11" width="30" height="30" rx="9" fill="#1E40AF"/>
            <path d="M20 21h14v10a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 20 31z" fill="none" stroke="#9DC0FF" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M20 21l7 6 7-6" fill="none" stroke="#9DC0FF" stroke-width="1.5" stroke-linejoin="round"/>
            <text x="54" y="30" fill="#EAF0FF" font-family="Geist,sans-serif" font-size="13" font-weight="600">Intake</text>
            <text x="54" y="44" fill="#7E8AAC" font-family="Geist Mono,monospace" font-size="9.5">email · forms</text>
          </g>
          <g transform="translate(220,24)">
            <rect width="160" height="52" rx="13" fill="#131B33" stroke="rgba(255,255,255,.1)"/>
            <rect x="12" y="11" width="30" height="30" rx="9" fill="#0E7490"/>
            <path d="M27 16l8 3.5v5.5c0 4.5-4 6.5-8 8-4-1.5-8-3.5-8-8v-5.5z" fill="none" stroke="#7DE3F4" stroke-width="1.5" stroke-linejoin="round"/>
            <text x="54" y="30" fill="#EAF0FF" font-family="Geist,sans-serif" font-size="13" font-weight="600">Validate</text>
            <text x="54" y="44" fill="#7E8AAC" font-family="Geist Mono,monospace" font-size="9.5">rules engine</text>
          </g>
          <g transform="translate(220,144)">
            <rect width="160" height="52" rx="13" fill="#131B33" stroke="rgba(34,211,238,.35)"/>
            <rect x="12" y="11" width="30" height="30" rx="9" fill="#1E40AF"/>
            <rect x="20" y="19" width="14" height="14" rx="3" fill="none" stroke="#9DC0FF" stroke-width="1.5"/>
            <path d="M23 16v3M27 16v3M31 16v3M23 33v3M27 33v3M31 33v3M16 23h3M16 27h3M16 31h3M35 23h3M35 27h3M35 31h3" stroke="#9DC0FF" stroke-width="1.3" stroke-linecap="round"/>
            <text x="54" y="30" fill="#EAF0FF" font-family="Geist,sans-serif" font-size="13" font-weight="600">Enrich</text>
            <text x="54" y="44" fill="#6FE3F0" font-family="Geist Mono,monospace" font-size="9.5">AI model</text>
          </g>
          <g transform="translate(220,264)">
            <rect width="160" height="52" rx="13" fill="#131B33" stroke="rgba(255,255,255,.1)"/>
            <rect x="12" y="11" width="30" height="30" rx="9" fill="#B45309"/>
            <path d="M27 17l9.5 17h-19z" fill="none" stroke="#FCD9A6" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M27 24v5" stroke="#FCD9A6" stroke-width="1.8" stroke-linecap="round"/>
            <circle cx="27" cy="32" r="1" fill="#FCD9A6"/>
            <text x="54" y="30" fill="#EAF0FF" font-family="Geist,sans-serif" font-size="13" font-weight="600">Exception</text>
            <text x="54" y="44" fill="#7E8AAC" font-family="Geist Mono,monospace" font-size="9.5">human review</text>
          </g>
          <g transform="translate(426,74)">
            <rect width="160" height="52" rx="13" fill="#131B33" stroke="rgba(255,255,255,.1)"/>
            <rect x="12" y="11" width="30" height="30" rx="9" fill="#15803D"/>
            <path d="M20 26l4.5 4.5L34 21" fill="none" stroke="#A7F3C4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <text x="54" y="30" fill="#EAF0FF" font-family="Geist,sans-serif" font-size="13" font-weight="600">Approve</text>
            <text x="54" y="44" fill="#7E8AAC" font-family="Geist Mono,monospace" font-size="9.5">policy gate</text>
          </g>
          <g transform="translate(426,214)">
            <rect width="160" height="52" rx="13" fill="#131B33" stroke="rgba(255,255,255,.1)"/>
            <rect x="12" y="11" width="30" height="30" rx="9" fill="#1E40AF"/>
            <rect x="20" y="19" width="14" height="6" rx="1.5" fill="none" stroke="#9DC0FF" stroke-width="1.4"/>
            <rect x="20" y="28" width="14" height="6" rx="1.5" fill="none" stroke="#9DC0FF" stroke-width="1.4"/>
            <circle cx="23.6" cy="22" r=".9" fill="#9DC0FF"/>
            <circle cx="23.6" cy="31" r=".9" fill="#9DC0FF"/>
            <text x="54" y="30" fill="#EAF0FF" font-family="Geist,sans-serif" font-size="13" font-weight="600">Sync</text>
            <text x="54" y="44" fill="#7E8AAC" font-family="Geist Mono,monospace" font-size="9.5">ERP · CRM</text>
          </g>
        </svg>
        <!-- footer stat strip -->
        <div style="position:relative; display:flex; gap:10px; margin-top:6px;">
          <div style="flex:1; background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.07); border-radius:11px; padding:11px 13px;">
            <div style="font-family:'Geist Mono',monospace; font-size:10px; letter-spacing:.05em; color:#69769B; text-transform:uppercase;">Touchless rate</div>
            <div style="font-size:19px; font-weight:600; color:#fff; margin-top:3px;">94.2%</div>
          </div>
          <div style="flex:1; background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.07); border-radius:11px; padding:11px 13px;">
            <div style="font-family:'Geist Mono',monospace; font-size:10px; letter-spacing:.05em; color:#69769B; text-transform:uppercase;">Avg. latency</div>
            <div style="font-size:19px; font-weight:600; color:#fff; margin-top:3px;">1.8<span style="font-size:12px; color:#9AA6C4;">s</span></div>
          </div>
          <div style="flex:1; background:rgba(34,211,238,.1); border:1px solid rgba(34,211,238,.22); border-radius:11px; padding:11px 13px;">
            <div style="font-family:'Geist Mono',monospace; font-size:10px; letter-spacing:.05em; color:#7DE3F4; text-transform:uppercase;">Errors caught</div>
            <div style="font-size:19px; font-weight:600; color:#fff; margin-top:3px;">1,204</div>
          </div>
        </div>
      </div>
      <!-- floating badge -->
      <div style="position:absolute; left:-22px; bottom:48px; background:#fff; border-radius:14px; padding:12px 15px; box-shadow:0 18px 44px -10px rgba(17,22,31,.28); display:flex; align-items:center; gap:11px; animation:cl-float 6s ease-in-out infinite;">
        <span style="position:relative; width:34px; height:34px; border-radius:10px; background:#ECFDF5; display:flex; align-items:center; justify-content:center;">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#15803D" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg>
        </span>
        <div><div style="font-size:13px; font-weight:600; color:#11161F;">Reconciled &amp; posted</div><div style="font-family:'Geist Mono',monospace; font-size:10.5px; color:#6A7180;">no human touch · 0 errors</div></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ LOGO MARQUEE ============ -->
<section style="padding:6px 0 44px; position:relative;">
  <div style="max-width:1240px; margin:0 auto 22px; padding:0 28px; display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap;">
    <p style="margin:0; font-family:'Geist Mono',monospace; font-size:12px; letter-spacing:.05em; text-transform:uppercase; color:#7A828F;">Trusted by teams across India</p>
    <div style="display:inline-flex; align-items:center; gap:9px; padding:6px 12px; border:1px solid rgba(30,64,175,.18); border-radius:8px; background:#fff; font-size:12.5px; color:#41495A;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="#F59E0B" stroke="none"><path d="m12 2 2.9 6.3 6.9.6-5.2 4.6 1.6 6.8L12 17l-6.2 3.3 1.6-6.8L2.2 8.9l6.9-.6z"/></svg>
      Software · AI · Automation · Growth — <strong style="color:#11161F;">one team</strong>
    </div>
  </div>
  <div data-marquee style="position:relative; overflow:hidden; -webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent); mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);">
    <div style="display:flex; gap:56px; width:max-content; animation:cl-marquee 36s linear infinite; align-items:center; padding:6px 28px;" data-marquee-track>
      <span style="font-size:21px; font-weight:700; letter-spacing:-.02em; color:#9298A4;">Sharda Industries</span>
      <span style="font-size:21px; font-weight:600; letter-spacing:.02em; color:#9298A4; font-style:italic;">TransIndia</span>
      <span style="font-size:21px; font-weight:800; letter-spacing:-.04em; color:#9298A4;">FINOVO</span>
      <span style="font-size:20px; font-weight:500; color:#9298A4;">MediCare</span>
      <span style="font-size:21px; font-weight:700; color:#9298A4;">Apex Motors</span>
      <span style="font-size:20px; font-weight:600; letter-spacing:.08em; color:#9298A4;">BRIGHTLINE</span>
      <span style="font-size:21px; font-weight:700; letter-spacing:-.02em; color:#9298A4;">Zenith Retail</span>
      <span style="font-size:20px; font-weight:500; color:#9298A4;">Nova Tech</span>
      <span style="font-size:21px; font-weight:800; letter-spacing:-.03em; color:#9298A4;">URBANFOODS</span>
      <span style="font-size:20px; font-weight:600; color:#9298A4;">Kisan Agro</span>
      <!-- duplicate for seamless loop -->
      <span style="font-size:21px; font-weight:700; letter-spacing:-.02em; color:#9298A4;">Sharda Industries</span>
      <span style="font-size:21px; font-weight:600; letter-spacing:.02em; color:#9298A4; font-style:italic;">TransIndia</span>
      <span style="font-size:21px; font-weight:800; letter-spacing:-.04em; color:#9298A4;">FINOVO</span>
      <span style="font-size:20px; font-weight:500; color:#9298A4;">MediCare</span>
      <span style="font-size:21px; font-weight:700; color:#9298A4;">Apex Motors</span>
      <span style="font-size:20px; font-weight:600; letter-spacing:.08em; color:#9298A4;">BRIGHTLINE</span>
      <span style="font-size:21px; font-weight:700; letter-spacing:-.02em; color:#9298A4;">Zenith Retail</span>
      <span style="font-size:20px; font-weight:500; color:#9298A4;">Nova Tech</span>
      <span style="font-size:21px; font-weight:800; letter-spacing:-.03em; color:#9298A4;">URBANFOODS</span>
      <span style="font-size:20px; font-weight:600; color:#9298A4;">Kisan Agro</span>
    </div>
  </div>
</section>

<!-- ============ STAT BAND (dark) ============ -->
<section style="position:relative; background:#0A0E1A; color:#fff; padding:84px 0; overflow:hidden;">
  <div style="position:absolute; inset:0; background-image:radial-gradient(rgba(255,255,255,.05) 1px,transparent 1px); background-size:3px 3px; opacity:.5; pointer-events:none;"></div>
  <div style="position:absolute; top:-1px; left:50%; transform:translateX(-50%); width:60%; height:1px; background:linear-gradient(90deg,transparent,rgba(34,211,238,.7),transparent);"></div>
  <div style="position:absolute; width:520px; height:520px; left:-160px; top:-200px; background:radial-gradient(circle,rgba(30,64,175,.4),transparent 60%); filter:blur(40px); pointer-events:none;"></div>
  <div style="max-width:1240px; margin:0 auto; padding:0 28px; position:relative;">
    <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:24px; flex-wrap:wrap; margin-bottom:46px;" data-reveal>
      <h2 style="margin:0; font-size:clamp(28px,3.4vw,40px); line-height:1.05; letter-spacing:-.03em; font-weight:300; max-width:620px;">We don't just write code.<br><span style="font-weight:700;">We deliver outcomes.</span></h2>
